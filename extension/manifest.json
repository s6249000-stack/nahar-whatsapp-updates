{
  "manifest_version": 3,
  "name": "נהר שלום - תזמון ופרסום WhatsApp",
  "version": "0.6.20",
  "description": "פרסום מיידי בערוץ והעברה לקבוצות, תזמון ובדיקות WhatsApp Web",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nahar-shalom-tools.pages.dev/tools/whatsapp-scheduler/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "נהר שלום - WhatsApp"
  }
}
